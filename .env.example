# ===========================================
# JS Rush - Environment Variables
# Copy this file to .env and fill in your values
# ===========================================

# ===========================================
# Database (Supabase/PostgreSQL)
# ===========================================
# Local development (SQLite)
# DATABASE_URL=sqlite:///casino.db

# Production (Supabase Pooler)
# Format: postgresql://user:password@host:port/database
DATABASE_URL=postgresql://postgres:password@db:5432/jsrush

# ===========================================
# Redis
# ===========================================
REDIS_URL=redis://redis:6379/0

# ===========================================
# Security (Generate with: python -c "import secrets; print(secrets.token_hex(32))")
# ===========================================
SECRET_KEY=your-32-character-secret-key-here
JWT_SECRET_KEY=another-32-character-secret-key-here

# ===========================================
# Email (Gmail SMTP with App Password)
# ===========================================
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-16-char-app-password
MAIL_DEFAULT_SENDER=JS Rush <noreply@yourdomain.com>

# ===========================================
# Whish Money (Production)
# ===========================================
WHISH_CHANNEL=your_production_channel_id
WHISH_SECRET=your_production_secret_key
WHISH_WEBSITE_URL=https://yourdomain.com
WHISH_BASE_URL=https://whish.money/itel-service/api
WHISH_WEBHOOK_SECRET=your_webhook_secret
WHISH_SANDBOX=false

# ===========================================
# Frontend
# ===========================================
NEXT_PUBLIC_API_URL=https://api.yourdomain.com

# ===========================================
# Security
# ===========================================
SECRET_KEY=your-32-character-secret-key-here
JWT_SECRET_KEY=another-32-character-secret-key-here
SERVER_NAME=yourdomain.com

# ===========================================
# Whish Money (Production)
# ===========================================
WHISH_CHANNEL=your_production_channel_id
WHISH_SECRET=your_production_secret_key
WHISH_WEBSITE_URL=https://yourdomain.com
WHISH_BASE_URL=https://whish.money/itel-service/api
WHISH_WEBHOOK_SECRET=your_webhook_secret
WHISH_SANDBOX=false

# ===========================================
# Email (Gmail SMTP)
# ===========================================
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-16-char-app-password
MAIL_DEFAULT_SENDER=JS Rush <noreply@yourdomain.com>

# ===========================================
# WhatsApp
# ===========================================
WHATSAPP_NUMBER=96171903956

# ===========================================
# Frontend
# ===========================================
NEXT_PUBLIC_API_URL=https://api.yourdomain.com

# ===========================================
# Security
# ===========================================
EMAIL_VERIFICATION_REQUIRED=true
ADMIN_2FA_REQUIRED=true
MAX_LOGIN_ATTEMPTS=5
LOGIN_LOCKOUT_DURATION=900

# ===========================================
# Logging
# ===========================================
LOG_LEVEL=INFO
SENTRY_DSN=

# ===========================================
# Celery
# ===========================================
CELERY_BROKER_URL=redis://redis:6379/2
CELERY_RESULT_BACKEND=redis://redis:6379/3

# ===========================================
# Google OAuth (Optional)
# ===========================================
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ===========================================
# Database (Auto-configured in docker-compose)
# ===========================================
# DATABASE_URL=postgresql://postgres:password@db:5432/jsrush

# ===========================================
# Redis (Auto-configured in docker-compose)
# ===========================================
# REDIS_URL=redis://redis:6379/0