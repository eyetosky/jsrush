# Flask
FLASK_ENV=development
FLASK_DEBUG=true
SECRET_KEY=dev-secret-key-change-in-production-min-32-chars-long
SERVER_NAME=localhost:5000

# Database (SQLite for local dev - IPv6 network issue with Supabase)
DATABASE_URL=sqlite:///casino.db

# Redis (optional for local dev)
REDIS_URL=redis://localhost:6379/0

# Security
JWT_SECRET_KEY=dev-jwt-secret-key-change-in-production
JWT_ACCESS_TOKEN_EXPIRES=3600
JWT_REFRESH_TOKEN_EXPIRES=86400
BCRYPT_ROUNDS=12

# Rate Limiting
RATELIMIT_DEFAULT=200 per minute
RATELIMIT_STORAGE_URL=redis://localhost:6379/1

# Payment Gateways - Whish Money (Lebanon) - SANDBOX
WHISH_CHANNEL=your_sandbox_whish_channel_id
WHISH_SECRET=your_sandbox_whish_secret_key
WHISH_WEBSITE_URL=http://192.168.150.130:5000
WHISH_BASE_URL=https://lb.sandbox.whish.money/itel-service/api
WHISH_WEBHOOK_SECRET=your_sandbox_whish_webhook_secret
WHISH_SANDBOX=true

# Email Configuration (Gmail SMTP for Development)
# Create App Password: https://myaccount.google.com/apppasswords
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=jsrush.noreply@gmail.com
MAIL_PASSWORD=poshhstyasngjjyr
MAIL_DEFAULT_SENDER=JS Rush <jsrush.noreply@gmail.com>

# SMS Configuration (Twilio - supports Lebanon)
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+1xxxxxxxxxx

# Security
BCRYPT_ROUNDS=12
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_HTTPONLY=true
SESSION_COOKIE_SAMESITE=Lax
PERMANENT_SESSION_LIFETIME=3600

# Login Security
MAX_LOGIN_ATTEMPTS=5
LOGIN_LOCKOUT_DURATION=900
EMAIL_VERIFICATION_REQUIRED=true
PHONE_VERIFICATION_REQUIRED=false
LOGIN_NOTIFICATION_EMAIL=true
TRUSTED_DEVICES_ENABLED=true

# Gambling Compliance (USD amounts for Lebanon)
MIN_DEPOSIT=10
MAX_DEPOSIT=10000
MIN_WITHDRAWAL=20
MAX_WITHDRAWAL=5000
DAILY_DEPOSIT_LIMIT=5000
DAILY_WITHDRAWAL_LIMIT=2000
KYC_REQUIRED_AMOUNT=2000

# Responsible Gambling
DEFAULT_DAILY_DEPOSIT_LIMIT=500
DEFAULT_DAILY_LOSS_LIMIT=200
SESSION_TIMEOUT=1800

# Admin
ADMIN_EMAIL=admin@jsrush.com

# WhatsApp Contact for Manual Deposits/Withdrawals
WHATSAPP_NUMBER=96171903956

# Frontend URL
FRONTEND_URL=http://192.168.150.130:5000

# Logging
LOG_LEVEL=DEBUG
