# Flask
FLASK_ENV=production
FLASK_DEBUG=false
SECRET_KEY=generate-with-python-c secrets.token_hex(32)

# Server name for external URLs (required for email verification links)
SERVER_NAME=jsrush.com

# Database (PostgreSQL for production - Supabase pooler)
DATABASE_URL=postgresql://postgres:pHRneOHv7uweiB7X@db.kjrcjadawbjxygdkcsaq.supabase.co:6543/postgres

# Redis (required for production)
REDIS_URL=redis://localhost:6379/0

# Security
JWT_SECRET_KEY=generate-with-python-c secrets.token_hex(32)
JWT_ACCESS_TOKEN_EXPIRES=3600
JWT_REFRESH_TOKEN_EXPIRES=86400
BCRYPT_ROUNDS=12
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_HTTPONLY=true
SESSION_COOKIE_SAMESITE=Lax
PERMANENT_SESSION_LIFETIME=3600

# Login Security
MAX_LOGIN_ATTEMPTS=5
LOGIN_LOCKOUT_DURATION=900
EMAIL_VERIFICATION_REQUIRED=true
PHONE_VERIFICATION_REQUIRED=false
LOGIN_NOTIFICATION_EMAIL=true
TRUSTED_DEVICES_ENABLED=true

# Rate Limiting
RATELIMIT_DEFAULT=200 per minute
RATELIMIT_STORAGE_URL=redis://localhost:6379/1

# Payment Gateways - Whish Money (Lebanon) - PRODUCTION
WHISH_CHANNEL=your_production_whish_channel_id
WHISH_SECRET=your_production_whish_secret_key
WHISH_WEBSITE_URL=https://jsrush.com
WHISH_BASE_URL=https://whish.money/itel-service/api
WHISH_WEBHOOK_SECRET=your_production_whish_webhook_secret
WHISH_SANDBOX=false

# Email (Gmail SMTP)
